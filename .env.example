# API local. APP_ORIGIN é a origem pública da API, usada pelo OAuth e pelo webhook.
# No Render, omita APP_ORIGIN para usar RENDER_EXTERNAL_URL fornecida pela plataforma.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
# Origem exata da SPA para CORS, operações com cookie e retorno do Google.
# Exemplo em produção: https://nome-do-site.netlify.app
FRONTEND_ORIGIN=http://localhost:5173
# Origens adicionais de CORS, em CSV, sem caminhos ou curingas. Use HTTPS em produção.
CORS_ORIGINS=
# IPs ou faixas CIDR de proxies reversos confiáveis, em CSV.
TRUSTED_PROXIES=

# PostgreSQL. O comando db:local usa as credenciais e a porta desta URL.
DATABASE_URL=postgresql://mesa:mesa_local@127.0.0.1:55432/mesa?schema=public
# Redis não é utilizado. O PostgreSQL coordena SSE, bloqueios e rate limits.
# REDIS_URL=redis://127.0.0.1:6379

# Obrigatório. Gere um segredo de pelo menos 32 bytes. local:env gera um para uso local.
JWT_SECRET=

# Credenciais do seed. Em produção, informe o e-mail explicitamente.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=

# Em produção, informe explicitamente mock para a demo ou mercado_pago para cobranças reais.
PAYMENT_PROVIDER=mock
MERCADO_PAGO_ACCESS_TOKEN=
# Segredo de Webhooks do Mercado Pago. No mock, pode ficar vazio para derivação do JWT_SECRET.
PAYMENT_WEBHOOK_SECRET=
# Chave independente de 32 bytes em base64url. Obrigatória em produção e compartilhada entre réplicas.
TICKET_ENCRYPTION_KEY=

# Cliente OAuth do tipo Aplicativo da Web. Configure as duas variáveis juntas.
# URI cadastrada no Google: APP_ORIGIN + /auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CAPTCHA opcional na API. Requer um cliente que envie captchaToken.
# Hostname esperado do widget, sem esquema/porta. Padrão: FRONTEND_ORIGIN, ou APP_ORIGIN se ausente.
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=
# Número de falhas consecutivas antes de exigir o desafio no login (1 a 4).
CAPTCHA_LOGIN_AFTER_FAILURES=2

# SMTP obrigatório para cobranças reais em produção. Localmente, vazio grava em .local/mail/.
# Em produção com mock, vazio habilita cadastro verificado automaticamente e desliga recuperação por e-mail.
SMTP_URL=
MAIL_FROM="Sistema Mesa <contato@example.test>"

# Playwright. Portas distintas das usadas no desenvolvimento.
# E2E_API_URL permite sobrescrever a URL local correspondente à porta da API.
E2E_API_PORT=3001
E2E_FRONTEND_PORT=5174
E2E_API_URL=
# Vazio usa o Chromium instalado pelo Playwright. Exemplo de canal instalado: chrome.
E2E_BROWSER_CHANNEL=
