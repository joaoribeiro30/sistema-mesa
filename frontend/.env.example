# Configuração pública incorporada pelo Vite no build. Mantenha segredos no backend.
# Use o mesmo hostname da SPA no desenvolvimento (localhost) para os cookies do Google.
# No Netlify, defina a URL HTTPS pública do backend nas variáveis do build.
VITE_API_BASE_URL=http://localhost:3000

# Chave pública da aplicação usada pelo backend em modo mercado_pago.
# Deixe vazia com PAYMENT_PROVIDER=mock para usar a tokenização simulada.
VITE_MERCADO_PAGO_PUBLIC_KEY=

# O frontend atual ainda não renderiza o widget Turnstile.
# TURNSTILE_SECRET_KEY e demais segredos de integrações são exclusivos do backend.
