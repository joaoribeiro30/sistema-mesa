generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum EventDisplayMode {
  MAP
  LIST
  BOTH
}

enum EventImageKind {
  COVER
  BANNER
  FLOOR_PLAN
}

enum TableChangeKind {
  LOCKED
  RELEASED
  SOLD
}

enum ReservationStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  REFUND_REQUIRED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
}

enum AccountTokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String         @unique @db.VarChar(254)
  name              String         @db.VarChar(120)
  passwordHash      String?        @map("password_hash") @db.VarChar(255)
  emailVerifiedAt   DateTime?      @map("email_verified_at") @db.Timestamptz(3)
  role              UserRole       @default(CUSTOMER)
  sessionVersion    Int            @default(0) @map("session_version")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  googleIdentity    GoogleIdentity?
  accountTokens     AccountToken[]
  oauthAttempts     OAuthAttempt[]
  reservations      Reservation[]
  admissions        Reservation[] @relation("CheckInOperator")

  @@map("users")
}

model GoogleIdentity {
  subject   String   @id @db.VarChar(255)
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@map("google_identities")
}

model AccountToken {
  tokenHash      String           @id @map("token_hash") @db.Char(64)
  userId         String           @map("user_id") @db.Uuid
  kind           AccountTokenKind
  sessionVersion Int              @map("session_version")
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt         DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId, kind])
  @@index([expiresAt])
  @@map("account_tokens")
}

model OAuthAttempt {
  stateHash          String   @id @map("state_hash") @db.Char(64)
  browserHash        String   @map("browser_hash") @db.Char(64)
  nonce              String   @db.VarChar(128)
  codeVerifier       String   @map("code_verifier") @db.VarChar(128)
  linkUserId         String?  @map("link_user_id") @db.Uuid
  linkSessionVersion Int?     @map("link_session_version")
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(3)
  linkUser           User?    @relation(fields: [linkUserId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([expiresAt])
  @@index([linkUserId])
  @@map("oauth_attempts")
}

model Event {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String           @unique @db.VarChar(120)
  title             String           @db.VarChar(160)
  description       String?
  venue             String           @db.VarChar(160)
  city              String?          @db.VarChar(120)
  category          String?          @db.VarChar(120)
  coverImageUrl     String?          @map("cover_image_url") @db.VarChar(2048)
  bannerImageUrl    String?          @map("banner_image_url") @db.VarChar(2048)
  floorPlanImageUrl String?          @map("floor_plan_image_url") @db.VarChar(2048)
  displayMode       EventDisplayMode @default(BOTH) @map("display_mode")
  currency          String           @db.Char(3)
  status            EventStatus      @default(DRAFT)
  startsAt          DateTime         @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime         @map("ends_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  sectors           Sector[]
  reservations      Reservation[]
  images            EventImage[]
  stream            EventStream?

  @@unique([id, currency])
  @@index([status, startsAt])
  @@map("events")
}

model Sector {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String       @map("event_id") @db.Uuid
  name           String       @db.VarChar(120)
  description    String?
  basePriceMinor Int          @default(0) @map("base_price_minor")
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tables         EventTable[]

  @@unique([id, eventId])
  @@unique([eventId, name])
  @@map("sectors")
}

model EventTable {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sectorId     String        @map("sector_id") @db.Uuid
  eventId      String        @map("event_id") @db.Uuid
  label        String        @db.VarChar(60)
  capacity     Int
  priceMinor   Int           @map("price_minor")
  isEnabled    Boolean       @default(true) @map("is_enabled")
  x            Float?
  y            Float?
  sector       Sector        @relation(fields: [sectorId, eventId], references: [id, eventId], onDelete: Restrict, onUpdate: Restrict)
  reservations Reservation[]

  @@unique([id, eventId])
  @@unique([sectorId, label])
  @@index([eventId, isEnabled, priceMinor])
  @@map("tables")
}

model EventImage {
  eventId   String         @map("event_id") @db.Uuid
  kind      EventImageKind
  mediaType String         @map("media_type") @db.VarChar(16)
  content   Bytes
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([eventId, kind])
  @@map("event_images")
}

model EventStream {
  eventId String             @id @map("event_id") @db.Uuid
  version BigInt             @default(0)
  event   Event              @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  changes EventTableChange[]

  @@map("event_streams")
}

model EventTableChange {
  eventId   String          @map("event_id") @db.Uuid
  version   BigInt
  tableId   String          @map("table_id") @db.Uuid
  kind      TableChangeKind
  expiresAt DateTime?       @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  stream    EventStream     @relation(fields: [eventId], references: [eventId], onDelete: Cascade, onUpdate: Restrict)

  @@id([eventId, version])
  @@map("event_table_changes")
}

model Reservation {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  tableId        String            @map("table_id") @db.Uuid
  eventId        String            @map("event_id") @db.Uuid
  idempotencyKey String            @map("idempotency_key") @db.Uuid
  status         ReservationStatus @default(PENDING_PAYMENT)
  guestCount     Int               @map("guest_count")
  capacity       Int
  amountMinor    Int               @map("amount_minor")
  currency       String            @db.Char(3)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)
  confirmedAt    DateTime?         @map("confirmed_at") @db.Timestamptz(3)
  ticketToken    String?           @unique @map("ticket_token") @db.VarChar(512)
  checkedInAt    DateTime?         @map("checked_in_at") @db.Timestamptz(3)
  checkedInById  String?           @map("checked_in_by_id") @db.Uuid
  cancelledAt    DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  checkedInBy    User?             @relation("CheckInOperator", fields: [checkedInById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  table          EventTable        @relation(fields: [tableId, eventId], references: [id, eventId], onDelete: Restrict, onUpdate: Restrict)
  event          Event             @relation(fields: [eventId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)
  payments       Payment[]

  @@unique([userId, idempotencyKey])
  @@unique([id, amountMinor, currency])
  @@index([userId, createdAt])
  @@index([tableId, eventId])
  @@index([eventId, status])
  @@index([eventId, createdAt, id])
  @@index([checkedInById])
  @@index([status, expiresAt])
  @@map("reservations")
}

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId     String        @map("reservation_id") @db.Uuid
  provider          String        @db.VarChar(40)
  providerPaymentId String?       @map("provider_payment_id") @db.VarChar(255)
  idempotencyKey    String        @map("idempotency_key") @db.Uuid
  amountMinor       Int           @map("amount_minor")
  currency          String        @db.Char(3)
  status            PaymentStatus @default(PENDING)
  method            PaymentMethod?
  requestHash       String?       @map("request_hash") @db.Char(64)
  pixCode           String?       @map("pix_code")
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(3)
  refundedAt        DateTime?     @map("refunded_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  reservation       Reservation   @relation(fields: [reservationId, amountMinor, currency], references: [id, amountMinor, currency], onDelete: Restrict, onUpdate: Restrict)
  webhookEvents     PaymentWebhookEvent[]

  @@unique([provider, providerPaymentId])
  @@unique([provider, idempotencyKey])
  @@index([reservationId, createdAt])
  @@map("payments")
}

model PaymentWebhookEvent {
  provider   String   @db.VarChar(40)
  eventId    String   @map("event_id") @db.VarChar(255)
  paymentId  String   @map("payment_id") @db.Uuid
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([provider, eventId])
  @@index([paymentId])
  @@map("payment_webhook_events")
}

enum AuditAction {
  LOGIN_LOCKED
  LOGIN_BLOCKED
  ADMIN_OVERVIEW_VIEWED
  ADMIN_CREATED
  USER_ROLE_CHANGED
  PASSWORD_RESET
  GOOGLE_LINKED
  PAYMENT_STATUS_CHANGED
  ADMIN_EVENT_CREATED
  ADMIN_EVENT_UPDATED
  ADMIN_EVENT_DELETED
  ADMIN_SECTOR_CREATED
  ADMIN_SECTOR_UPDATED
  ADMIN_SECTOR_DELETED
  ADMIN_TABLE_CREATED
  ADMIN_TABLE_UPDATED
  ADMIN_TABLE_DELETED
  ADMIN_TABLES_CREATED
  ADMIN_EVENT_LAYOUT_UPDATED
  ADMIN_EVENT_IMAGE_UPLOADED
  RESERVATION_CHECKED_IN
}

model AuditLog {
  id            BigInt      @id @default(autoincrement())
  action        AuditAction
  actorUserId   String?     @map("actor_user_id") @db.Uuid
  subjectUserId String?     @map("subject_user_id") @db.Uuid
  eventId       String?     @map("event_id") @db.Uuid
  reservationId String?     @map("reservation_id") @db.Uuid
  paymentId     String?     @map("payment_id") @db.Uuid
  details       Json
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([action, createdAt])
  @@index([paymentId, createdAt])
  @@index([eventId, createdAt])
  @@map("audit_logs")
}

model LoginAttempt {
  key         String    @id @db.Char(64)
  failures    Int       @default(0)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("login_attempts")
}

model RateLimitBucket {
  key       String   @id @db.Char(64)
  hits      Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
